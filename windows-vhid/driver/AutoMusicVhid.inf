[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=AutoMusicVhid.cat
DriverVer=09/23/2026,0.1.0.0
PnpLockdown=1

[DestinationDirs]
DriverCopy=12

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
AutoMusicVhid.sys=1

[Manufacturer]
%ProviderName%=Models,NTamd64

[Models.NTamd64]
%DeviceName%=DeviceInstall,Root\AutoMusicVhid

[DeviceInstall.NT]
CopyFiles=DriverCopy

[DriverCopy]
AutoMusicVhid.sys

[DeviceInstall.NT.HW]
AddReg=VhfLowerFilter

[VhfLowerFilter]
HKR,,LowerFilters,0x00010000,"vhf"

[DeviceInstall.NT.Services]
AddService=AutoMusicVhid,0x00000002,ServiceInstall

[ServiceInstall]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\AutoMusicVhid.sys

[DeviceInstall.NT.Wdf]
KmdfService=AutoMusicVhid,KmdfInstall

[KmdfInstall]
KmdfLibraryVersion=1.15

[Strings]
ProviderName="Auto Music"
DeviceName="Auto Music Virtual HID Source"
DiskName="Auto Music Virtual HID Driver"
